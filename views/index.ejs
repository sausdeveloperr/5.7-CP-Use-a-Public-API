<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Country Info app</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
  <link rel="stylesheet" href="/css/output.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='16'>🌍</text></svg>">
</head>

<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300"
  style="background-color: var(--color-bg); color: var(--color-text);">
  <!-- Main container -->
  <div class=" flex items-start justify-center min-h-fit px-4 pb-2">
    <!-- Content wrapper -->
    <main class="w-full max-w-2xl mt-8 md:mt-16">
      <!-- Header with logo -->
      <header class=" text-center mb-3 md:mb-8">
        <!-- Logo/Brand box -->
        <div class="mb-4">
          <div
            class="inline-flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-2xl border-4 border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 transition-all duration-300">
            <span class="material-icons text-4xl md:text-5xl text-blue-500 dark:text-blue-400">public</span>
          </div>
        </div>

        <!-- Main title -->
        <h1 class="text-5xl md:text-6xl font-bold mb-6 text-gray-900 dark:text-white transition-colors duration-300">
          Country Info</h1>

        <!-- Subtitle/Description -->
        <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl mx-auto leading-relaxed font-light"
          style="color: var(--color-text); opacity: 0.8;">
          Discover key information about countries around the world.
        </p>
      </header>

      <!-- Search section -->
      <section class=" my-3 md:my-5">
        <form id="countrySearchForm" method="POST" action="/search" class=" flex flex-col gap-4 md:flex-row md:gap-3">
          <!-- Search input -->
          <div class="flex-1 relative">
            <!-- input field -->
            <label for="searchInput" class="sr-only">Search for a country</label>
            <div class="relative flex items-center">
              <!-- Input with dropdown overlay -->
              <input 
                type="text" 
                id="searchInput" 
                name="searchInput" 
                placeholder="Enter country name..." 
                aria-label="Search for a country" 
                aria-describedby="searchHint"
                autocomplete="off"
                class="w-full px-4 md:px-6 py-3 md:py-4 pr-32 rounded-2xl border-2 border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-500 dark:placeholder-gray-400 focus:outline-none focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 transition-all duration-200 text-base md:text-lg"
                required 
              />
              
              <!-- transformed dropdown -->
              <select
                id="searchType"
                name="searchType"
                class="absolute right-2 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 border border-gray-400 dark:border-gray-600 rounded-xl px-3 py-1.5 text-sm font-medium focus:outline-none focus:border-blue-500 dark:focus:border-blue-400 focus:ring-2 focus:ring-blue-200 dark:focus:ring-blue-900 cursor-pointer appearance-none"
              >
                <option value="name" selected>Name</option>
                <option value="alpha">Alpha Code</option>
                <option value="capital">Capital</option>
                <option value="region">Region</option>
                <option value="currency">Currency</option>
                <option value="language">Language</option>
                <option value="demonym">Demonym</option>
              </select>
            </div>
            
            <div id="autocompleteDropdown" class="closed"></div>
            <div id="searchHint" class="sr-only text-sm text-gray-500 dark:text-gray-400 mt-2">
              Type query and select search type above
            </div>
          </div>

          <!-- Search button -->
           <!-- Add loading state for this in main.js once button is clicked (e.g., show a FE spinner in #mainContent while waiting for the API response)  -->
          <button type="submit" aria-label="Search for country"
            class=" px-3 md:px-4 py-1 md:py-1.5 bg-blue-500 hover:scale-105 active:bg-blue-700 active:scale-95 dark:bg-blue-600 dark:hover:bg-blue-500 dark:active:bg-blue-700 text-white font-semibold rounded-2xl flex items-center justify-center gap-2 transition-all duration-200 hover:shadow-lg active:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
            style="background-color: var(--color-accent);">
            <span class="material-icons text-3xl md:text-4xl">search</span>
            <span class="md:hidden">Search</span>
          </button>
        </form>
      </section>

      <!-- Accessibility skip link -->
      <a href="#mainContent"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-500 focus:text-white focus:rounded">Skip
        to main content</a>
    </main>
  </div>

  <!-- Main content area (for results) -->
  <div id="mainContent" role="main" class="px-4 py-8" aria-live="polite" aria-label="Search results area">
    <!-- Results will go here -->
    <% if (locals.content) { %>
      <% 
        try {
          const countries = typeof content === 'string' ? JSON.parse(content) : content;
          if (Array.isArray(countries) && countries.length === 1) { /* too lazy for this lol  */
      %>
        <div class="max-w-3xl mx-auto">
          <% countries.forEach(country => { %>
            <%- include('partials/countryCard', { country }) %>
          <% }); %>
        </div>
      <% 
          }
          else if (Array.isArray(countries) && countries.length > 1) {
      %>
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
            <% countries.forEach(country => { %>
              <%- include('partials/previewCountry', { country }) %>
            <% }); %>
          </div>
        </div>
      <% 
          }
        } catch (err) {
          console.error('Error parsing country data:', err);
      %>
        <div class="max-w-2xl mx-auto bg-red-50 dark:bg-gray-800 border border-red-200 dark:border-gray-700 rounded-2xl p-6 text-center">
          <p class="text-red-700 dark:text-red-400 font-semibold"><%= content %></p>
        </div>
      <% 
        }
      %>
    <% } %>
  </div>

  <script src="/js/main.js" defer></script>
</body>

</html>